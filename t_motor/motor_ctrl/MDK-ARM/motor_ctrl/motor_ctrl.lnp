--cpu Cortex-M3
"motor_ctrl\startup_stm32f103xb.o"
"motor_ctrl\motor.o"
"motor_ctrl\pid.o"
"motor_ctrl\main.o"
"motor_ctrl\gpio.o"
"motor_ctrl\dma.o"
"motor_ctrl\tim.o"
"motor_ctrl\usart.o"
"motor_ctrl\stm32f1xx_it.o"
"motor_ctrl\stm32f1xx_hal_msp.o"
"motor_ctrl\stm32f1xx_hal_gpio_ex.o"
"motor_ctrl\stm32f1xx_hal_tim.o"
"motor_ctrl\stm32f1xx_hal_tim_ex.o"
"motor_ctrl\stm32f1xx_hal.o"
"motor_ctrl\stm32f1xx_hal_rcc.o"
"motor_ctrl\stm32f1xx_hal_rcc_ex.o"
"motor_ctrl\stm32f1xx_hal_gpio.o"
"motor_ctrl\stm32f1xx_hal_dma.o"
"motor_ctrl\stm32f1xx_hal_cortex.o"
"motor_ctrl\stm32f1xx_hal_pwr.o"
"motor_ctrl\stm32f1xx_hal_flash.o"
"motor_ctrl\stm32f1xx_hal_flash_ex.o"
"motor_ctrl\stm32f1xx_hal_exti.o"
"motor_ctrl\stm32f1xx_hal_uart.o"
"motor_ctrl\system_stm32f1xx.o"
--strict --scatter "motor_ctrl\motor_ctrl.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "motor_ctrl.map" -o motor_ctrl\motor_ctrl.axf